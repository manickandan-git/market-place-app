# Public host URLs used by pytest. Start all services before running the tests.
AUTH_SERVICE_URL=http://localhost:8001
NOTIFICATION_SERVICE_URL=http://localhost:8002
USER_SERVICE_URL=http://localhost:8003
PRODUCT_SERVICE_URL=http://localhost:8004
INVENTORY_SERVICE_URL=http://localhost:8005
CART_SERVICE_URL=http://localhost:8006
ORDER_SERVICE_URL=http://localhost:8007
PAYMENT_SERVICE_URL=http://localhost:8008
SHIPPING_SERVICE_URL=http://localhost:8009

# Health and Identity endpoints. Change these only when your service routes differ.
AUTH_HEALTH_PATH=/health
AUTH_JWKS_PATH=/.well-known/jwks.json
NOTIFICATION_HEALTH_PATH=/health
USER_HEALTH_PATH=/api/v1/health/live
PRODUCT_HEALTH_PATH=/health
INVENTORY_HEALTH_PATH=/health
CART_HEALTH_PATH=/health
ORDER_HEALTH_PATH=/health
PAYMENT_HEALTH_PATH=/health
SHIPPING_HEALTH_PATH=/health

# Token validation contract shared by every service below Auth.
JWT_ISSUER=http://localhost:8001
JWT_AUDIENCE=marketplace-api
JWT_ALGORITHMS=["RS256"]

# Must match payment-service's STRIPE_WEBHOOK_SECRET (docker-compose.yml
# hardcodes a fixed dev-only value for exactly this purpose) so the suite
# can sign synthetic Stripe events and POST them straight to
# /api/v1/webhooks/stripe — no `stripe listen` needed for automated runs.
STRIPE_WEBHOOK_SECRET=whsec_dev_only_e2e_workflow_test_secret

# Easiest option: paste short-lived integration tokens issued by Auth Service.
# Required roles/scopes:
# BUYER: buyer; SELLER_A/SELLER_B: seller; ADMIN: admin;
# INVENTORY_SYNC: scope inventory:sync (a service token is recommended).
BUYER_ACCESS_TOKEN=
SELLER_A_ACCESS_TOKEN=
SELLER_B_ACCESS_TOKEN=
ADMIN_ACCESS_TOKEN=
INVENTORY_SYNC_ACCESS_TOKEN=

# Optional: leave tokens empty and let the tests log in. These defaults assume
# POST /api/v1/auth/login with JSON {"email": ..., "password": ...} and an
# {"access_token": "..."} response. Adjust the fields if your Auth API differs.
AUTH_LOGIN_PATH=/api/v1/auth/login
AUTH_LOGIN_EMAIL_FIELD=email
AUTH_LOGIN_PASSWORD_FIELD=password
AUTH_LOGIN_TOKEN_FIELD=access_token
BUYER_EMAIL=buyer.integration@example.com
BUYER_PASSWORD=ChangeMe-Integration-123!
SELLER_A_EMAIL=seller.a.integration@example.com
SELLER_A_PASSWORD=ChangeMe-Integration-123!
SELLER_B_EMAIL=seller.b.integration@example.com
SELLER_B_PASSWORD=ChangeMe-Integration-123!
ADMIN_EMAIL=admin.integration@example.com
ADMIN_PASSWORD=ChangeMe-Integration-123!

# Notification remains internal and uses X-Internal-API-Key.
INTERNAL_API_KEY=integration-test-internal-key-change-me
# Set this to the real notification creation route to enable its tests.
# Example: /api/v1/notifications/email
NOTIFICATION_TEST_ENDPOINT=
NOTIFICATION_API_KEY_HEADER=X-Internal-API-Key

# HTTP behavior.
HTTP_TIMEOUT_SECONDS=20
STARTUP_TIMEOUT_SECONDS=90
VERIFY_TLS=true

