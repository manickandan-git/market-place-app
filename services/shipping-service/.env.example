ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://marketplace:marketplace@localhost:5441/shipping_service

# JWT_ISSUER is a literal string compared against the access token's "iss"
# claim, which auth-service bakes in from its own JWT_ISSUER setting
# (http://localhost:8001) — this must match that value exactly and is NOT
# a network address, unlike JWT_JWKS_URL below.
JWT_ISSUER=http://localhost:8001
JWT_AUDIENCE=marketplace-api
JWT_JWKS_URL=http://localhost:8001/.well-known/jwks.json

AUTH_SERVICE_URL=http://localhost:8001
ORDER_SERVICE_URL=http://localhost:8007

# Must match the SHIPPING_SERVICE_CLIENT_ID/SECRET registered in
# auth-service's .env — used to obtain an orders:fulfillment-scoped
# service token via POST /api/v1/auth/service-token.
SHIPPING_SERVICE_CLIENT_ID=shipping-service
SHIPPING_SERVICE_CLIENT_SECRET=shipping-service-secret-12345


CORS_ORIGINS=["http://localhost:3000"]
