ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://payment:payment@localhost:5440/payment_service

# JWT_ISSUER is a literal string compared against the access token's "iss"
# claim, which auth-service bakes in from its own JWT_ISSUER setting
# (http://localhost:8001) — this must match that value exactly and is NOT
# a network address, unlike JWT_JWKS_URL below.
JWT_ISSUER=http://localhost:8001
JWT_AUDIENCE=marketplace-api
JWT_JWKS_URL=http://localhost:8001/.well-known/jwks.json

AUTH_SERVICE_URL=http://localhost:8001
ORDER_SERVICE_URL=http://localhost:8007

# Must match the PAYMENT_SERVICE_CLIENT_ID/SECRET registered in
# auth-service's .env — used to obtain an orders:payment-scoped service
# token via POST /api/v1/auth/service-token.
PAYMENT_SERVICE_CLIENT_ID=payment-service
PAYMENT_SERVICE_CLIENT_SECRET=

# Stripe test-mode keys (https://dashboard.stripe.com/test/apikeys).
# STRIPE_WEBHOOK_SECRET comes from `stripe listen --forward-to
# localhost:8008/api/v1/webhooks/stripe` when running locally — see
# README.md.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

CORS_ORIGINS=["http://localhost:3000"]
