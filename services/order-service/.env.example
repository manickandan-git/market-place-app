DATABASE_URL=postgresql+asyncpg://marketplace:marketplace@localhost:5439/order_service
JWT_JWKS_URL=http://localhost:8001/.well-known/jwks.json
JWT_ISSUER=http://localhost:8001
JWT_AUDIENCE=marketplace-api
JWT_ALGORITHMS=["RS256"]
AUTH_SERVICE_URL=http://localhost:8001
CART_SERVICE_URL=http://localhost:8006
PRODUCT_SERVICE_URL=http://localhost:8004
INVENTORY_SERVICE_URL=http://localhost:8005
NOTIFICATION_SERVICE_URL=http://localhost:8003
NOTIFICATION_INTERNAL_API_KEY=replace-with-internal-key
# Client credentials for POST /api/v1/auth/service-token (inventory:commit +
# cart:checkout scopes) — must match auth-service's
# ORDER_SERVICE_CLIENT_ID/SECRET.
ORDER_SERVICE_CLIENT_ID=order-service
ORDER_SERVICE_CLIENT_SECRET=
CORS_ORIGINS=["http://localhost:3000"]
