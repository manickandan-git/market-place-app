APP_NAME=Marketplace Auth Service
APP_ENV=development
API_V1_PREFIX=/api/v1
DATABASE_URL=
REDIS_URL=
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
# Access tokens are signed with RS256 and verified by other services via
# GET /.well-known/jwks.json. Generate a keypair with
# `python scripts/generate_jwt_keypair.py` before deploying — if the files
# below are missing, the service falls back to an ephemeral in-memory
# keypair that is regenerated (and invalidates outstanding tokens) on every
# restart.
JWT_ACCESS_ALGORITHM=RS256
JWT_PRIVATE_KEY_PATH=keys/jwt_private_key.pem
JWT_PUBLIC_KEY_PATH=keys/jwt_public_key.pem
JWT_KID=auth-key-1
JWT_ISSUER=http://localhost:8001
JWT_AUDIENCE=marketplace-api
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
EMAIL_VERIFICATION_EXPIRE_MINUTES=30

PASSWORD_RESET_EXPIRE_MINUTES=30

MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15

# Service-to-service client credentials (POST /api/v1/auth/service-token).
# Registered clients: Inventory Sync (inventory:sync scope), Payment
# Service (orders:payment scope, to call Order's payment-authorized /
# payment-failed callbacks), Order Service (inventory:commit + cart:checkout
# scopes on one client — commit/release Inventory reservations when called
# by Payment rather than by the buyer directly, and mark a cart checked-out
# after placing an order), and Shipping Service (orders:fulfillment scope,
# to call Order's fulfillment callback as a shipment moves through
# processing/shipped/delivered).  SUBJECT must be a UUID — consuming
# services treat the token's sub claim as one.
SERVICE_TOKEN_EXPIRE_MINUTES=15
INVENTORY_SYNC_CLIENT_ID=inventory-sync-service
INVENTORY_SYNC_CLIENT_SECRET=inventory-sync-service-secret-12345
INVENTORY_SYNC_SUBJECT=00000000-0000-0000-0000-000000000001
PAYMENT_SERVICE_CLIENT_ID=payment-service
PAYMENT_SERVICE_CLIENT_SECRET=payment-service-secret-12345
PAYMENT_SERVICE_SUBJECT=00000000-0000-0000-0000-000000000002
ORDER_SERVICE_CLIENT_ID=order-service
ORDER_SERVICE_CLIENT_SECRET=order-service-secret-12345
ORDER_SERVICE_SUBJECT=00000000-0000-0000-0000-000000000003
SHIPPING_SERVICE_CLIENT_ID=shipping-service
SHIPPING_SERVICE_CLIENT_SECRET=shipping-service-secret-12345
SHIPPING_SERVICE_SUBJECT=00000000-0000-0000-0000-000000000004
