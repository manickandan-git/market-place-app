# ============================================================
# Application
# ============================================================

APP_NAME=Marketplace Notification Service
APP_ENV=development
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1

HOST=0.0.0.0
PORT=8002
LOG_LEVEL=INFO

# ============================================================
# Database
# ============================================================

DATABASE_URL=postgresql+asyncpg://marketplace:marketplace@localhost:5432/marketplace_notifications
DATABASE_ECHO=false

# When running with Docker Compose, use:
# DATABASE_URL=postgresql+asyncpg://marketplace:marketplace@notification-postgres:5432/marketplace_notifications

# ============================================================
# Redis and Celery
# ============================================================

REDIS_URL=redis://localhost:6379/1
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

CELERY_TASK_ALWAYS_EAGER=false
CELERY_TASK_EAGER_PROPAGATES=true
CELERY_TASK_MAX_RETRIES=5
CELERY_RETRY_DELAY_SECONDS=30

# When running with Docker Compose, use:
# REDIS_URL=redis://redis:6379/1
# CELERY_BROKER_URL=redis://redis:6379/1
# CELERY_RESULT_BACKEND=redis://redis:6379/2

# ============================================================
# Email provider
# ============================================================

# console prints emails to worker logs.
# smtp sends messages through an SMTP server.
EMAIL_PROVIDER=smtp

DEFAULT_FROM_EMAIL=your-gmail-address@gmail.com
DEFAULT_FROM_NAME=Marketplace
SUPPORT_EMAIL=your-gmail-address@gmail.com
NOTIFICATION_MAXIMUM_RETRY_COUNT=3

# ============================================================
# SMTP
# ============================================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-gmail-address@gmail.com
# Use a Google App Password (not your normal Gmail account password).
SMTP_PASSWORD=replace-with-gmail-app-password
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=30

# ============================================================
# Celery task settings
# ============================================================

CELERY_TASK_TIME_LIMIT_SECONDS=120
CELERY_TASK_SOFT_TIME_LIMIT_SECONDS=90          
CELERY_DEFAULT_RETRY_DELAY_SECONDS=30
CELERY_EMAIL_RATE_LIMIT=100/m   

# ============================================================
# Marketplace URLs
# ============================================================

MARKETPLACE_WEB_URL=http://localhost:3000
EMAIL_VERIFICATION_PATH=/verify-email
PASSWORD_RESET_PATH=/reset-password

# ============================================================
# Internal service authentication
# ============================================================

INTERNAL_API_KEY=replace-this-with-a-long-random-internal-key
IDENTITY_SERVICE_URL=http://localhost:8001

# ============================================================
# Notification settings
# ============================================================

MAXIMUM_RECIPIENT_COUNT=10
NOTIFICATION_RETENTION_DAYS=90

VERIFICATION_EMAIL_SUBJECT=Verify your Marketplace account
PASSWORD_RESET_EMAIL_SUBJECT=Reset your Marketplace password
PASSWORD_CHANGED_EMAIL_SUBJECT=Your Marketplace password was changed

CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]