APP_NAME=Marketplace Inventory Service
ENVIRONMENT=development
DEBUG=false
DATABASE_URL=postgresql+asyncpg://marketplace:marketplace@localhost:5437/inventory_service
JWT_JWKS_URL=http://localhost:8001/.well-known/jwks.json
JWT_ISSUER=http://localhost:8001
JWT_AUDIENCE=marketplace-api
JWT_ALGORITHMS=["RS256"]
JWKS_CACHE_SECONDS=300
CORS_ORIGINS=["http://localhost:3000"]
DEFAULT_RESERVATION_MINUTES=15
MAX_RESERVATION_MINUTES=60
LOW_STOCK_DEFAULT_THRESHOLD=5
SQL_ECHO=false
