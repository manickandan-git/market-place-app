{
  "id": null,
  "uid": "assistant-service-observability",
  "title": "Assistant Service - Observability",
  "tags": [
    "assistant-service"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Chat requests / min",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(count_over_time({service=\"marketplace-assistant-service\"} |= `chat_request` [$__auto]))",
          "legendFormat": "requests",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Chat request latency (avg ms)",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "avg_over_time({service=\"marketplace-assistant-service\"} |= `chat_request` | regexp `(?P<json_payload>\\{.*\\})` | line_format `{{.json_payload}}` | json | unwrap latency_ms [$__auto])",
          "legendFormat": "avg latency_ms",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Chat requests by stop_reason",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (stop_reason) (count_over_time({service=\"marketplace-assistant-service\"} |= `chat_request` | regexp `(?P<json_payload>\\{.*\\})` | line_format `{{.json_payload}}` | json [$__auto]))",
          "legendFormat": "{{stop_reason}}",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Anthropic token usage / min",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(sum_over_time({service=\"marketplace-assistant-service\"} |= `chat_request` | regexp `(?P<json_payload>\\{.*\\})` | line_format `{{.json_payload}}` | json | unwrap input_tokens [$__auto]))",
          "legendFormat": "input_tokens",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        },
        {
          "expr": "sum(sum_over_time({service=\"marketplace-assistant-service\"} |= `chat_request` | regexp `(?P<json_payload>\\{.*\\})` | line_format `{{.json_payload}}` | json | unwrap output_tokens [$__auto]))",
          "legendFormat": "output_tokens",
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Downstream call latency by service (avg ms)",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (service_extracted) (avg_over_time({service=\"marketplace-assistant-service\"} |= `downstream_call` | regexp `(?P<json_payload>\\{.*\\})` | line_format `{{.json_payload}}` | json | unwrap duration_ms [$__auto]))",
          "legendFormat": "{{service_extracted}}",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Chat rate-limit hits (429s) / min",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(count_over_time({service=\"marketplace-assistant-service\"} |= `chat_rate_limited` [$__auto]))",
          "legendFormat": "429s",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Downstream calls by status code",
      "gridPos": {
        "x": 8,
        "y": 16,
        "w": 16,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (status_code) (count_over_time({service=\"marketplace-assistant-service\"} |= `downstream_call` | regexp `(?P<json_payload>\\{.*\\})` | line_format `{{.json_payload}}` | json [$__auto]))",
          "legendFormat": "{{status_code}}",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ]
    },
    {
      "id": 8,
      "type": "logs",
      "title": "Raw event log (chat_request / downstream_call / chat_rate_limited)",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "expr": "{service=\"marketplace-assistant-service\"} |~ `chat_request|downstream_call|chat_rate_limited`",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ]
    }
  ]
}